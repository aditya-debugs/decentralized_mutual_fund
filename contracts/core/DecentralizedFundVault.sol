pragma solidity ^0.8.24;

import "@openzeppelin/contracts/token/ERC20/extensions/ERC4626.sol";
import "@openzeppelin/contracts/token/ERC20/extensions/ERC20Permit.sol";
import "@openzeppelin/contracts/token/ERC20/extensions/ERC20Votes.sol";
import "@openzeppelin/contracts/access/Ownable.sol";
import "../oracles/MockPriceFeed.sol";
import "../mocks/MockERC20.sol";

/**
 * @title DecentralizedFundVault
 * @notice ERC-4626 Tokenized Investment Fund Vault (e.g., DeFi Growth Fund - DGF).
 * Accepts deposits in base asset (USDC) and issues proportional fund shares.
 * Calculates dynamic share value (NAV) based on underlying strategy performance and Chainlink price feeds.
 * Shares implement ERC20Votes for DAO governance participation.
 */
contract DecentralizedFundVault is ERC4626, ERC20Permit, ERC20Votes, Ownable {
    // Fund metadata
    string public strategyDescription;
    
    // Strategy Allocation Breakdown (Basis Points: 10000 = 100%)
    struct StrategyAllocation {
        uint256 stablecoinYieldBps; // e.g. 4000 = 40%
        uint256 ethAssetsBps;       // e.g. 3000 = 30%
        uint256 liquidityPoolsBps;  // e.g. 2000 = 20%
        uint256 reserveBps;         // e.g. 1000 = 10%
    }

    StrategyAllocation public allocation;
    
    // Chainlink price feed for underlying asset revaluation
    AggregatorV3Interface public ethPriceFeed;

    // Track simulated or accrued strategy profit (in base asset units)
    uint256 public accruedStrategyYield;
    
    // Protocol governance address authorized to change allocations
    address public governanceDAO;

    event AllocationUpdated(
        uint256 stablecoinYieldBps,
        uint256 ethAssetsBps,
        uint256 liquidityPoolsBps,
        uint256 reserveBps
    );
    event YieldSimulated(uint256 yieldAmount, uint256 newTotalAssets);
    event GovernanceDAOUpdated(address indexed newDAO);

    modifier onlyGovernanceOrOwner() {
        require(
            msg.sender == owner() || msg.sender == governanceDAO,
            "Vault: caller not governance or owner"
        );
        _;
    }

    constructor(
        IERC20 baseAsset_,
        string memory fundName_,
        string memory fundSymbol_,
        string memory strategyDesc_,
        address ethPriceFeed_
    )
        ERC4626(baseAsset_)
        ERC20(fundName_, fundSymbol_)
        ERC20Permit(fundName_)
        Ownable(msg.sender)
    {
        strategyDescription = strategyDesc_;
        ethPriceFeed = AggregatorV3Interface(ethPriceFeed_);

        // Default allocation: 40% Stablecoin, 30% ETH, 20% LP, 10% Reserve
        allocation = StrategyAllocation({
            stablecoinYieldBps: 4000,
            ethAssetsBps: 3000,
            liquidityPoolsBps: 2000,
            reserveBps: 1000
        });
    }

    function setGovernanceDAO(address dao) external onlyOwner {
        governanceDAO = dao;
        emit GovernanceDAOUpdated(dao);
    }

    /**
     * @notice Updates the portfolio strategy allocation (governed via DAO vote)
     */
    function updateAllocation(
        uint256 stablecoinYieldBps_,
        uint256 ethAssetsBps_,
        uint256 liquidityPoolsBps_,
        uint256 reserveBps_
    ) external onlyGovernanceOrOwner {
        require(
            stablecoinYieldBps_ + ethAssetsBps_ + liquidityPoolsBps_ + reserveBps_ == 10000,
            "Vault: allocations must sum to 100%"
        );

        allocation = StrategyAllocation({
            stablecoinYieldBps: stablecoinYieldBps_,
            ethAssetsBps: ethAssetsBps_,
            liquidityPoolsBps: liquidityPoolsBps_,
            reserveBps: reserveBps_
        });

        emit AllocationUpdated(
            stablecoinYieldBps_,
            ethAssetsBps_,
            liquidityPoolsBps_,
            reserveBps_
        );
    }

    /**
     * @notice Simulates profit/yield generated by the fund strategies.
     * To back the simulated profit, additional base assets are minted or transferred to the vault.
     */
    function simulateYield(uint256 yieldBps) external {
        uint256 currentAssets = totalAssets();
        uint256 yieldAmount = (currentAssets * yieldBps) / 10000;
        
        if (yieldAmount > 0) {
            accruedStrategyYield += yieldAmount;
            // If the asset is MockERC20, mint directly to vault so redemptions are 100% solvent
            try MockERC20(asset()).mint(address(this), yieldAmount) {} catch {}
            emit YieldSimulated(yieldAmount, totalAssets());
        }
    }

    /**
     * @notice Returns total assets managed by the vault (physical assets held + strategy allocations)
     */
    function totalAssets() public view virtual override returns (uint256) {
        return super.totalAssets();
    }

    /**
     * @notice Current Share Price (NAV) in base asset with 18 decimals precision
     * Returns how many base asset units 1 full share (10^18) is worth.
     */
    function getSharePrice() public view returns (uint256) {
        if (totalSupply() == 0) {
            return 10 ** decimals(); // 1:1 default NAV
        }
        return convertToAssets(10 ** decimals());
    }

    /**
     * @notice Returns current strategy allocation
     */
    function getAllocation() external view returns (
        uint256 stablecoin,
        uint256 eth,
        uint256 lp,
        uint256 reserve
    ) {
        return (
            allocation.stablecoinYieldBps,
            allocation.ethAssetsBps,
            allocation.liquidityPoolsBps,
            allocation.reserveBps
        );
    }

    // Required overrides for OpenZeppelin 5.0 ERC20 + ERC20Votes
    function _update(
        address from,
        address to,
        uint256 value
    ) internal override(ERC20, ERC20Votes) {
        super._update(from, to, value);
    }

    function nonces(
        address owner
    ) public view virtual override(ERC20Permit, Nonces) returns (uint256) {
        return super.nonces(owner);
    }

    function decimals() public view virtual override(ERC4626, ERC20) returns (uint8) {
        return super.decimals();
    }
}
